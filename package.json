{
  "name": "league-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Personal post-game League of Legends coach: match review, mistake timeline and role finder.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && npm run ensure-electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && npm run ensure-electron && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ensure-electron": "node scripts/ensure-electron.js",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "three": "^0.170.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/touchdowned/league-coach.git"
  },
  "author": "touchdowned",
  "build": {
    "appId": "com.touchdowned.leaguecoach",
    "productName": "League Coach",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "League Coach",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "League-Coach-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "touchdowned",
        "repo": "league-coach",
        "releaseType": "release"
      }
    ]
  }
}
